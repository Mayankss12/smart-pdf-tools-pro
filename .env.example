# Public production origin. Replace after purchasing the domain.
# Use the origin only: no path, query string, fragment, or trailing route.
NEXT_PUBLIC_SITE_URL=https://your-pdfmantra-domain.example

# Supabase public project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OTP_ATTEMPT_HASH_SECRET=
CRON_SECRET=

# Existing PDFMantra storage buckets.
PDFMANTRA_DOCUMENTS_BUCKET=documents
PDFMANTRA_OUTPUTS_BUCKET=outputs
PDFMANTRA_SIGNATURES_BUCKET=signatures
